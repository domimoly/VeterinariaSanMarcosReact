# Producción: el navegador llama a Nginx (mismo origen) y Nginx reenvía a cada microservicio.
# Así no hace falta abrir los puertos 8082-8086 ni configurar CORS entre dominios distintos.
VITE_AUTH_API_URL=/api/auth-service
VITE_MASCOTAS_API_URL=/api/mascotas-service
VITE_CITAS_API_URL=/api/citas-service
VITE_FICHAS_API_URL=/api/fichas-service
VITE_PRODUCTOS_API_URL=/api/productos-service
VITE_PEDIDOS_API_URL=/api/pedidos-service
